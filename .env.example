DATABASE_URL=postgresql://postgres:postgres@db:5432/papanin

# --- LLM (src/lib/server/llm/provider.ts) ---
# Prefix PAPANIN_LLM_* agar tidak bentrok dengan LLM_* yang di-inject runtime editor/agent.
PAPANIN_LLM_PROVIDER=anthropic
PAPANIN_LLM_BASE_URL=https://api.z.ai/api/anthropic/v1
PAPANIN_LLM_MODEL=glm-5.2
PAPANIN_LLM_API_KEY=isikan_key_z_ai_kamu

# --- Payment Gateway (src/lib/server/payment) ---
# Kredensial gateway (apiKey, webhook secret/token) disimpan di tabel
# payment_gateway (JSONB credentials + kolom webhook_secret), dikelola admin
# via /admin/payment-gateways — BUKAN env. Ini hanya override opsional:
# Base URL SumoPod. Default: https://api-pay-sandbox.sumopod.com/api/v1
# PAPANIN_PAYMENT_SUMOPOD_BASE_URL=https://api-pay.sumopod.com/api/v1
# Webhook URL yg didaftarkan di SumoPod Settings:
#   https://<host>/api/webhooks/payment/sumopod
# Signing secret (svix) + webhook token dari SumoPod Settings. Provider
# otomatis pakai nilai di tabel payment_gateway kalau ada, fallback ke env ini.
PAPANIN_PAYMENT_SUMOPOD_API_KEY=isikan_api_key_sumopod_kamu
PAPANIN_PAYMENT_SUMOPOD_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAPANIN_PAYMENT_SUMOPOD_WEBHOOK_TOKEN=whtok_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (src/lib/server/email) ---
# Provider: "log" (default, cetak ke console — dev) | "smtp"
# Switching SMTP vendor = ubah host/port/user/pass, app ga peduli backend.
PAPANIN_EMAIL_PROVIDER=log
PAPANIN_EMAIL_FROM=noreply@papanin.app
PAPANIN_EMAIL_FROM_NAME=Papanin
# SMTP (utk "smtp"). Contoh: Gmail / Amazon SES / Brevo / Mailgun / Mailtrap.
# PAPANIN_EMAIL_SMTP_HOST=smtp.mailtrap.io
# PAPANIN_EMAIL_SMTP_PORT=587        # 465 = implicit TLS, 587 = STARTTLS
# PAPANIN_EMAIL_SMTP_USER=
# PAPANIN_EMAIL_SMTP_PASS=

